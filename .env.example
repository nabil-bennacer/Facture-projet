# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)

# --- S3 : bucket des factures (identifiants fournis par l'enseignant) ---
AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=default
S3_BUCKET=factures

# --- OCR : LightOnOCR-3 sur Hyperfluid (clé créée depuis la console) ---
# URL complète de l'endpoint chat/completions : voir la page du modèle sur la console
OCR_API_URL=
OCR_API_KEY=

# --- Entrepôt (chemins relatifs à la racine du projet) ---
# Pour développer sans la vraie extraction : SILVER_DIR=tests/fixtures/silver
SILVER_DIR=data/silver
BRONZE_DIR=data/bronze
WAREHOUSE_PATH=data/warehouse.duckdb

# --- Agent : LLM interchangeable par configuration ---
# Exemple 1, modèle hébergé (Claude) :
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# Exemple 2, modèle local via Ollama (décommenter, et commenter l'exemple 1) :
# LLM_PROVIDER=openai
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# Toute autre API compatible OpenAI marche aussi (Mistral, OpenAI, vLLM...) :
# LLM_PROVIDER=openai / LLM_MODEL=... / LLM_BASE_URL=... / LLM_API_KEY=...
